# ============================================================
# NextRisk AI (TRUVIA) - environment template. PLACEHOLDERS ONLY.
# Copy to `.env` (git-ignored) and replace every value.
# Docker Compose:  docker compose --env-file .env -f docker/docker-compose.yml up -d mysql
# ============================================================

# ---- MySQL container (read by docker compose) ----
MYSQL_ROOT_PASSWORD=<generate-a-strong-root-password>
MYSQL_DATABASE=nextrisk
MYSQL_USER=nextrisk
MYSQL_PASSWORD=<generate-a-strong-app-password>
# Host port published on 127.0.0.1 only
MYSQL_HOST_PORT=3306

# ---- Backend (read by Spring; also loaded from this file when run from backend/) ----
# Host-run backend (mvn spring-boot:run):      DB_HOST=localhost
# Backend inside Docker (compose `app` profile): DB_HOST is forced to `mysql` by compose
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nextrisk
DB_USER=nextrisk
DB_PASSWORD=<same-as-MYSQL_PASSWORD>

# >= 32 random characters. Generate e.g.:  openssl rand -base64 48
JWT_SECRET=<generate-at-least-32-random-chars>
JWT_ISSUER=nextrisk-api
JWT_AUDIENCE=nextrisk-web
JWT_ACCESS_TTL_MINUTES=15

# Explicit origin allowlist (comma separated, no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# true in production (HTTPS). Browsers accept Secure cookies on http://localhost as well.
REFRESH_COOKIE_SECURE=true
API_DOCS_ENABLED=true

# ---- First-admin provisioning (optional, one-time) ----
# Set both, start the backend once, then REMOVE them. Ignored if an admin already exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Administrator
